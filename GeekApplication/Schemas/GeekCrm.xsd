      <xs:element name="TenantId" type="crm:Uuid"/>
      <xs:element name="UserId" type="crm:Uuid"/>
      <xs:element name="Role" type="crm:TenantUserRole"/>
      <xs:element name="CreatedAt" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== Documents ===================== -->

  <xs:element name="GeekCrmTenant">
    <xs:annotation>
      <xs:documentation>
        One tenant's data. Every row's TenantId is this tenant, and every reference points at a row in
        this document, so a reference to another tenant's row fails validation.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Tenant" type="crm:Tenant"/>
        <xs:element name="Participant" type="crm:Participant" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="ContactPoint" type="crm:ContactPoint" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="ParticipantLink" type="crm:ParticipantLink" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="Pipeline" type="crm:Pipeline" minOccurs="0" maxOccurs="unbounded">
          <xs:unique name="StageNameUnique"><xs:selector xpath="crm:Stage"/><xs:field xpath="crm:Name"/></xs:unique>
        </xs:element>
        <xs:element name="Product" type="crm:Product" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="ProductPrice" type="crm:ProductPrice" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="PricingRules" type="crm:PricingRules" minOccurs="0"/>
        <xs:element name="PricingUpliftTier" type="crm:PricingUpliftTier" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="Deal" type="crm:Deal" minOccurs="0" maxOccurs="unbounded">
          <xs:unique name="DealParticipantUnique">
            <xs:selector xpath="crm:DealParticipant"/><xs:field xpath="crm:ParticipantId"/><xs:field xpath="crm:Role"/>
          </xs:unique>
        </xs:element>
        <xs:element name="Activity" type="crm:Activity" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="PropertyDefinition" type="crm:PropertyDefinition" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="PropertyValue" type="crm:PropertyValue" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="CustomerHolding" type="crm:CustomerHolding" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="Project" type="crm:Project" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="TenantUser" type="crm:TenantUser" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>

    <!--
      A key of a tenant-owned table is (TenantId, Id), and a reference to it carries the referencing row's
      own TenantId first: the composite foreign keys of the tenant boundary. A reference whose id is absent
      is not checked, as a composite key with a NULL column is not.
    -->
    <xs:key name="TenantKey"><xs:selector xpath="crm:Tenant"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:keyref name="RowTenant" refer="crm:TenantKey">
      <xs:selector xpath="crm:Participant|crm:ContactPoint|crm:ParticipantLink|crm:Pipeline|crm:Pipeline/crm:Stage|crm:Product|crm:ProductPrice|crm:PricingRules|crm:PricingUpliftTier|crm:Deal|crm:Deal/crm:LineItem|crm:Deal/crm:StageChange|crm:Deal/crm:DealParticipant|crm:Activity|crm:PropertyDefinition|crm:PropertyValue|crm:CustomerHolding|crm:Project|crm:TenantUser"/>
      <xs:field xpath="crm:TenantId"/>
    </xs:keyref>

    <xs:key name="ParticipantKey"><xs:selector xpath="crm:Participant"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="ContactPointKey"><xs:selector xpath="crm:ContactPoint"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="ParticipantLinkKey"><xs:selector xpath="crm:ParticipantLink"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="PipelineKey"><xs:selector xpath="crm:Pipeline"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="StageKey"><xs:selector xpath="crm:Pipeline/crm:Stage"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="ProductKey"><xs:selector xpath="crm:Product"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="ProductPriceKey"><xs:selector xpath="crm:ProductPrice"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="PricingRulesKey"><xs:selector xpath="crm:PricingRules"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="PricingUpliftTierKey"><xs:selector xpath="crm:PricingUpliftTier"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="DealKey"><xs:selector xpath="crm:Deal"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="DealLineItemKey"><xs:selector xpath="crm:Deal/crm:LineItem"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="DealStageChangeKey"><xs:selector xpath="crm:Deal/crm:StageChange"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="DealParticipantKey"><xs:selector xpath="crm:Deal/crm:DealParticipant"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="ActivityKey"><xs:selector xpath="crm:Activity"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="PropertyDefinitionKey"><xs:selector xpath="crm:PropertyDefinition"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="PropertyValueKey"><xs:selector xpath="crm:PropertyValue"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="CustomerHoldingKey"><xs:selector xpath="crm:CustomerHolding"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="ProjectKey"><xs:selector xpath="crm:Project"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="TenantUserKey"><xs:selector xpath="crm:TenantUser"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Id"/></xs:key>

    <!-- Unique rules. A row missing one of the fields is skipped, as a partial index skips a NULL. -->
    <xs:unique name="ParticipantExternalUnique">
      <xs:selector xpath="crm:Participant"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Kind"/><xs:field xpath="crm:ExternalId"/>
    </xs:unique>
    <xs:unique name="ParticipantLinkPairRoleUnique">
      <xs:selector xpath="crm:ParticipantLink"/><xs:field xpath="crm:FromParticipantId"/><xs:field xpath="crm:ToParticipantId"/><xs:field xpath="crm:Role"/>
    </xs:unique>
    <xs:unique name="ActivityExternalUnique">
      <xs:selector xpath="crm:Activity"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ExternalRef"/><xs:field xpath="crm:Channel"/><xs:field xpath="crm:Outcome"/>
    </xs:unique>
    <xs:unique name="PropertyDefinitionKeyUnique">
      <xs:selector xpath="crm:PropertyDefinition"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ObjectType"/><xs:field xpath="crm:Key"/>
    </xs:unique>
    <xs:unique name="PropertyValueUnique">
      <xs:selector xpath="crm:PropertyValue"/><xs:field xpath="crm:DefinitionId"/><xs:field xpath="crm:RecordId"/>
    </xs:unique>
    <xs:unique name="ProductCodeUnique">
      <xs:selector xpath="crm:Product"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:Code"/>
    </xs:unique>
    <xs:unique name="PricingRulesTenantUnique">
      <xs:selector xpath="crm:PricingRules"/><xs:field xpath="crm:TenantId"/>
    </xs:unique>
    <xs:unique name="HoldingLineItemUnique">
      <xs:selector xpath="crm:CustomerHolding"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:DealLineItemId"/>
    </xs:unique>

    <xs:keyref name="ContactPointParticipant" refer="crm:ParticipantKey">
      <xs:selector xpath="crm:ContactPoint"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ParticipantId"/>
    </xs:keyref>
    <xs:keyref name="LinkFromParticipant" refer="crm:ParticipantKey">
      <xs:selector xpath="crm:ParticipantLink"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:FromParticipantId"/>
    </xs:keyref>
    <xs:keyref name="LinkToParticipant" refer="crm:ParticipantKey">
      <xs:selector xpath="crm:ParticipantLink"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ToParticipantId"/>
    </xs:keyref>
    <xs:keyref name="ProductPartner" refer="crm:ParticipantKey">
      <xs:selector xpath="crm:Product"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:PartnerParticipantId"/>
    </xs:keyref>
    <xs:keyref name="ProductPriceProduct" refer="crm:ProductKey">
      <xs:selector xpath="crm:ProductPrice"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ProductId"/>
    </xs:keyref>
    <xs:keyref name="DealPipeline" refer="crm:PipelineKey">
      <xs:selector xpath="crm:Deal"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:PipelineId"/>
    </xs:keyref>
    <xs:keyref name="DealStage" refer="crm:StageKey">
      <xs:selector xpath="crm:Deal"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:StageId"/>
    </xs:keyref>
    <xs:keyref name="DealOrganization" refer="crm:ParticipantKey">
      <xs:selector xpath="crm:Deal"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:OrganizationParticipantId"/>
    </xs:keyref>
    <xs:keyref name="LineItemProduct" refer="crm:ProductKey">
      <xs:selector xpath="crm:Deal/crm:LineItem"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ProductId"/>
    </xs:keyref>
    <xs:keyref name="StageChangeFrom" refer="crm:StageKey">
      <xs:selector xpath="crm:Deal/crm:StageChange"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:FromStageId"/>
    </xs:keyref>
    <xs:keyref name="StageChangeTo" refer="crm:StageKey">
      <xs:selector xpath="crm:Deal/crm:StageChange"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ToStageId"/>
    </xs:keyref>
    <xs:keyref name="DealParticipantParticipant" refer="crm:ParticipantKey">
      <xs:selector xpath="crm:Deal/crm:DealParticipant"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ParticipantId"/>
    </xs:keyref>
    <xs:keyref name="ActivityParticipant" refer="crm:ParticipantKey">
      <xs:selector xpath="crm:Activity"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ParticipantId"/>
    </xs:keyref>
    <xs:keyref name="ActivityDeal" refer="crm:DealKey">
      <xs:selector xpath="crm:Activity"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:DealId"/>
    </xs:keyref>
    <xs:keyref name="PropertyValueDefinition" refer="crm:PropertyDefinitionKey">
      <xs:selector xpath="crm:PropertyValue"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:DefinitionId"/>
    </xs:keyref>
    <xs:keyref name="HoldingParticipant" refer="crm:ParticipantKey">
      <xs:selector xpath="crm:CustomerHolding"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ParticipantId"/>
    </xs:keyref>
    <xs:keyref name="HoldingProduct" refer="crm:ProductKey">
      <xs:selector xpath="crm:CustomerHolding"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ProductId"/>
    </xs:keyref>
    <xs:keyref name="HoldingDeal" refer="crm:DealKey">
      <xs:selector xpath="crm:CustomerHolding"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:DealId"/>
    </xs:keyref>
    <xs:keyref name="HoldingLineItem" refer="crm:DealLineItemKey">
      <xs:selector xpath="crm:CustomerHolding"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:DealLineItemId"/>
    </xs:keyref>
    <xs:keyref name="ProjectParticipant" refer="crm:ParticipantKey">
      <xs:selector xpath="crm:Project"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:ParticipantId"/>
    </xs:keyref>
    <xs:keyref name="ProjectDeal" refer="crm:DealKey">
      <xs:selector xpath="crm:Project"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:DealId"/>
    </xs:keyref>
    <xs:keyref name="ProjectHolding" refer="crm:CustomerHoldingKey">
      <xs:selector xpath="crm:Project"/><xs:field xpath="crm:TenantId"/><xs:field xpath="crm:CustomerHoldingId"/>
    </xs:keyref>
  </xs:element>

  <xs:element name="GeekCrmPlatform">
    <xs:annotation>
      <xs:documentation>The platform-scoped rows: tenants, their subscriptions to Geek products, and the industry lists.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Tenant" type="crm:Tenant" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="TenantSubscription" type="crm:TenantSubscription" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="NaicsCode" type="crm:NaicsCode" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="SicCode" type="crm:SicCode" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>

    <xs:key name="PlatformTenantKey"><xs:selector xpath="crm:Tenant"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:unique name="PlatformTenantSlugUnique"><xs:selector xpath="crm:Tenant"/><xs:field xpath="crm:Slug"/></xs:unique>
    <xs:key name="TenantSubscriptionKey"><xs:selector xpath="crm:TenantSubscription"/><xs:field xpath="crm:Id"/></xs:key>
    <xs:key name="NaicsCodeKey"><xs:selector xpath="crm:NaicsCode"/><xs:field xpath="crm:Code"/></xs:key>
    <xs:key name="SicCodeKey"><xs:selector xpath="crm:SicCode"/><xs:field xpath="crm:Code"/></xs:key>
    <xs:keyref name="SubscriptionTenant" refer="crm:PlatformTenantKey">
      <xs:selector xpath="crm:TenantSubscription"/><xs:field xpath="crm:SubscriberTenantId"/>
    </xs:keyref>
  </xs:element>

</xs:schema>
