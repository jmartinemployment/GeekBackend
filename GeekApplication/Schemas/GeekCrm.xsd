<?xml version="1.0" encoding="UTF-8"?>
<!--
  Geek-CRM's canonical contract (docs/GEEK-CRM-DATA-MODEL.md, "Canonical schema").

  This schema describes all of Geek-CRM: what is built and what is planned. Every type carries a
  phase marker in its appinfo (crm:phase, with status shipped or planned). Only shipped parts are
  authoritative: the database CHECK lists, the C# vocabularies in GeekApplication/Models/Crm and
  the table columns must match them exactly, and GeekBackend.Tests/Crm/SchemaContractTests.cs
  fails when they do not. A planned part becomes authoritative in the same push as its migration,
  when its marker flips to shipped.

  Every schema change starts here. Element names are PascalCase and map one to one to snake_case
  columns; crm:table names the table a type describes. A child row nested in its parent (a Stage
  in its Pipeline, a LineItem in its Deal) carries its parent's id by nesting, named by
  crm:parentKey, instead of repeating it as an element.

  Tenant-defined custom properties are not described here: PropertyDefinition and PropertyValue
  are, and each tenant's own keys and values are checked by the service against its definitions.

  The schema validates XML documents as a contract. It does not replace database constraints or
  API validation.

  Versioning: the namespace carries no version. Additions stay 1.x; a removal or a rename is 2.0
  and gets a new namespace ending in /v2.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:crm="https://geekatyourspot.com/schemas/geek-crm"
           targetNamespace="https://geekatyourspot.com/schemas/geek-crm"
           elementFormDefault="qualified"
           version="1.0">

  <!-- ===================== Shared types ===================== -->

  <xs:simpleType name="Uuid">
    <xs:annotation><xs:documentation>A lower-case UUID, as Postgres prints one.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Money">
    <xs:annotation><xs:documentation>An amount of money: numeric(12,2) in the database.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="12"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Percent">
    <xs:annotation><xs:documentation>A percentage from 0 to 100 with up to two decimals.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="5"/>
      <xs:fractionDigits value="2"/>
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="100"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Hours">
    <xs:annotation><xs:documentation>A number of hours, never negative.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="7"/>
      <xs:fractionDigits value="2"/>
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Quantity">
    <xs:annotation><xs:documentation>How many of a product, more than zero.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="10"/>
      <xs:fractionDigits value="2"/>
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Json">
    <xs:annotation><xs:documentation>A JSON value as text: a jsonb column.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="NaicsCodeValue">
    <xs:annotation><xs:documentation>A U.S. NAICS code: two to six digits, or a sector range such as 31-33.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{2}-[0-9]{2}|[0-9]{2,6}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SicCodeValue">
    <xs:annotation><xs:documentation>A U.S. SIC code: four digits.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===================== Vocabularies ===================== -->

  <xs:simpleType name="ParticipantKind">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>Whether a participant is a person or an organization. It never changes.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="person"/>
      <xs:enumeration value="organization"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LifecycleStage">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>Where a participant stands with the business. A prospect is a stage, not a kind.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="lead"/>
      <xs:enumeration value="prospect"/>
      <xs:enumeration value="customer"/>
      <xs:enumeration value="former_customer"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ParticipantSource">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>How a participant first reached the business.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="phone_call"/>
      <xs:enumeration value="text"/>
      <xs:enumeration value="website"/>
      <xs:enumeration value="referral"/>
      <xs:enumeration value="import"/>
      <xs:enumeration value="event"/>
      <xs:enumeration value="outreach"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ContactPointKind">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>The type of a contact point.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="phone"/>
      <xs:enumeration value="email"/>
      <xs:enumeration value="address"/>
      <xs:enumeration value="website"/>
      <xs:enumeration value="social"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ContactPointLabel">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>What a contact point is used for.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="mobile"/>
      <xs:enumeration value="work"/>
      <xs:enumeration value="home"/>
      <xs:enumeration value="main"/>
      <xs:enumeration value="billing"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ParticipantLinkRole">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>How one participant relates to another. A partner organization (Melio, Intuit) is linked with partner.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="owner"/>
      <xs:enumeration value="employee"/>
      <xs:enumeration value="decision_maker"/>
      <xs:enumeration value="billing_contact"/>
      <xs:enumeration value="referred_by"/>
      <xs:enumeration value="partner"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OrganizationType">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>An organization's legal form.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="sole_proprietor"/>
      <xs:enumeration value="llc"/>
      <xs:enumeration value="partnership"/>
      <xs:enumeration value="c_corporation"/>
      <xs:enumeration value="s_corporation"/>
      <xs:enumeration value="nonprofit"/>
      <xs:enumeration value="government"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RevenueBand">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>An organization's yearly revenue, as a band.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="under_250k"/>
      <xs:enumeration value="250k_1m"/>
      <xs:enumeration value="1m_5m"/>
      <xs:enumeration value="5m_25m"/>
      <xs:enumeration value="over_25m"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MaritalStatus">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>Recorded only when the person gives it; never asked, never scored.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="single"/>
      <xs:enumeration value="married"/>
      <xs:enumeration value="domestic_partner"/>
      <xs:enumeration value="divorced"/>
      <xs:enumeration value="widowed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EducationLevel">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>Recorded only when the person gives it.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="high_school"/>
      <xs:enumeration value="some_college"/>
      <xs:enumeration value="associate"/>
      <xs:enumeration value="bachelor"/>
      <xs:enumeration value="master"/>
      <xs:enumeration value="doctorate"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StageOutcome">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>Whether a pipeline stage is still open, or closes a deal as won or lost.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="open"/>
      <xs:enumeration value="won"/>
      <xs:enumeration value="lost"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DealParticipantRole">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>A participant's part in a deal. A deal cannot pass Qualified without a primary contact.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="primary_contact"/>
      <xs:enumeration value="decision_maker"/>
      <xs:enumeration value="influencer"/>
      <xs:enumeration value="billing"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ActivityChannel">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>How an activity happened.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="call"/>
      <xs:enumeration value="sms"/>
      <xs:enumeration value="voicemail"/>
      <xs:enumeration value="email"/>
      <xs:enumeration value="meeting"/>
      <xs:enumeration value="note"/>
      <xs:enumeration value="task"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ActivityDirection">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>Who started the exchange.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="inbound"/>
      <xs:enumeration value="outbound"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ActivityOutcome">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>How an activity ended.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="answered"/>
      <xs:enumeration value="missed"/>
      <xs:enumeration value="texted_back"/>
      <xs:enumeration value="voicemail_left"/>
      <xs:enumeration value="booked"/>
      <xs:enumeration value="no_show"/>
      <xs:enumeration value="completed"/>
      <xs:enumeration value="failed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ActivityPriority">
    <xs:annotation>
      <xs:appinfo><crm:phase status="planned">3</crm:phase></xs:appinfo>
      <xs:documentation>How soon a message needs attention; an existing customer's urgent message is urgent.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="normal"/>
      <xs:enumeration value="urgent"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PropertyObjectType">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>The kind of record a custom property belongs to.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="person"/>
      <xs:enumeration value="organization"/>
      <xs:enumeration value="deal"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PropertyDataType">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>The type of a custom property's value; the service checks each value against it.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="text"/>
      <xs:enumeration value="number"/>
      <xs:enumeration value="date"/>
      <xs:enumeration value="bool"/>
      <xs:enumeration value="enum"/>
      <xs:enumeration value="multi_enum"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ProductKind">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">2</crm:phase></xs:appinfo>
      <xs:documentation>
        geek_saas: a Geek product sold by subscription (Geek-Receptionist, Geek-Social, Geek-CRM).
        implementation: work done on a partner's platform (an invoice approval workflow on Melio, a QuickBooks setup).
        partner_subscription: the partner's own software (Melio, QuickBooks Online).
        support_plan: monthly support.
        service: bespoke work.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="geek_saas"/>
      <xs:enumeration value="implementation"/>
      <xs:enumeration value="partner_subscription"/>
      <xs:enumeration value="support_plan"/>
      <xs:enumeration value="service"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ProductCategory">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">2</crm:phase></xs:appinfo>
      <xs:documentation>The receptionist's five categories, so its question bank can find a product.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="accounting"/>
      <xs:enumeration value="business_operations"/>
      <xs:enumeration value="marketing"/>
      <xs:enumeration value="sales"/>
      <xs:enumeration value="bespoke"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Billing">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">2</crm:phase></xs:appinfo>
      <xs:documentation>How often a product is billed.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="one_time"/>
      <xs:enumeration value="monthly"/>
      <xs:enumeration value="annual"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HoldingStatus">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">2</crm:phase></xs:appinfo>
      <xs:documentation>Where a customer's holding stands. A tenant subscription uses the same list.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="proposed"/>
      <xs:enumeration value="active"/>
      <xs:enumeration value="paused"/>
      <xs:enumeration value="cancelled"/>
      <xs:enumeration value="ended"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PartnerArrangement">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">2</crm:phase></xs:appinfo>
      <xs:documentation>
        How a customer gets a partner subscription.
        customer_direct: the customer pays the partner; it is only tracked.
        referral: the customer signed up through the business's referral link.
        resold: the business buys it and bills the customer every month.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="customer_direct"/>
      <xs:enumeration value="referral"/>
      <xs:enumeration value="resold"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EstimateSize">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">2</crm:phase></xs:appinfo>
      <xs:documentation>The size an estimate is priced at.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="small"/>
      <xs:enumeration value="medium"/>
      <xs:enumeration value="large"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Currency">
    <xs:annotation>
      <xs:appinfo><crm:phase status="shipped">2</crm:phase></xs:appinfo>
      <xs:documentation>US dollars only for now; another currency is an addition, not a change.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="USD"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ProjectStatus">
    <xs:annotation>
      <xs:appinfo><crm:phase status="planned">3</crm:phase></xs:appinfo>
      <xs:documentation>Where a delivery project stands.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="scheduled"/>
      <xs:enumeration value="active"/>
      <xs:enumeration value="on_hold"/>
      <xs:enumeration value="done"/>
      <xs:enumeration value="cancelled"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TenantUserRole">
    <xs:annotation>
      <xs:appinfo><crm:phase status="planned">4</crm:phase></xs:appinfo>
      <xs:documentation>owner can do everything; member works leads and deals but cannot edit the catalog or pricing or see sensitive properties.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="owner"/>
      <xs:enumeration value="member"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===================== Tables: v0 ===================== -->

  <xs:complexType name="Tenant">
    <xs:annotation>
      <xs:appinfo><crm:table>tenants</crm:table><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>A business using Geek-CRM. Geek @ Your Spot is tenant #1. Platform-scoped.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Id" type="crm:Uuid"/>
      <xs:element name="Name" type="xs:string"/>
      <xs:element name="Slug" type="xs:string"/>
      <xs:element name="CreatedAt" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Participant">
    <xs:annotation>
      <xs:appinfo><crm:table>participants</crm:table><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>Anyone the business deals with, holding a Person or an Organization by kind.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Id" type="crm:Uuid"/>
      <xs:element name="TenantId" type="crm:Uuid"/>
      <xs:element name="Kind" type="crm:ParticipantKind"/>
      <xs:element name="DisplayName" type="xs:string"/>
      <xs:element name="LifecycleStage" type="crm:LifecycleStage"/>
      <xs:element name="Source" type="crm:ParticipantSource"/>
      <xs:element name="SourceDetail" type="xs:string" minOccurs="0"/>
      <xs:element name="OwnerUserId" type="crm:Uuid" minOccurs="0"/>
      <xs:element name="PreferredLanguage" type="xs:string" minOccurs="0"/>
      <xs:element name="Notes" type="xs:string" minOccurs="0"/>
      <xs:element name="ExternalId" type="xs:string" minOccurs="0"/>
      <xs:element name="CreatedAt" type="xs:dateTime"/>
      <xs:element name="UpdatedAt" type="xs:dateTime"/>
      <xs:element name="ArchivedAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="ImportBatchId" type="crm:Uuid" minOccurs="0">
        <xs:annotation>
          <xs:documentation>The import that created this row, so a batch can be reviewed and archived as a unit.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:choice>
        <xs:element name="Person" type="crm:Person"/>
        <xs:element name="Organization" type="crm:Organization"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Person">
    <xs:annotation>
      <xs:appinfo><crm:table>persons</crm:table><crm:parentKey>participant_id</crm:parentKey><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>A participant of kind person. Demographics are optional and recorded only when the person gives them.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="FirstName" type="xs:string" minOccurs="0"/>
      <xs:element name="LastName" type="xs:string" minOccurs="0"/>
      <xs:element name="PreferredName" type="xs:string" minOccurs="0"/>
      <xs:element name="JobTitle" type="xs:string" minOccurs="0"/>
      <xs:element name="BirthDate" type="xs:date" minOccurs="0"/>
      <xs:element name="Gender" type="xs:string" minOccurs="0"/>
      <xs:element name="MaritalStatus" type="crm:MaritalStatus" minOccurs="0"/>
      <xs:element name="DependentsCount" type="xs:int" minOccurs="0"/>
      <xs:element name="EducationLevel" type="crm:EducationLevel" minOccurs="0"/>
      <xs:element name="Occupation" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Organization">
    <xs:annotation>
      <xs:appinfo><crm:table>organizations</crm:table><crm:parentKey>participant_id</crm:parentKey><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>A participant of kind organization. It may exist without any person.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="LegalName" type="xs:string"/>
      <xs:element name="Dba" type="xs:string" minOccurs="0"/>
      <xs:element name="OrganizationType" type="crm:OrganizationType" minOccurs="0"/>
      <xs:element name="NaicsCode" type="crm:NaicsCodeValue" minOccurs="0"/>
      <xs:element name="SicCode" type="crm:SicCodeValue" minOccurs="0"/>
      <xs:element name="IndustryLabel" type="xs:string" minOccurs="0"/>
      <xs:element name="EmployeeCount" type="xs:int" minOccurs="0"/>
      <xs:element name="YearStarted" type="xs:int" minOccurs="0"/>
      <xs:element name="AnnualRevenueBand" type="crm:RevenueBand" minOccurs="0"/>
      <xs:element name="Website" type="xs:string" minOccurs="0"/>
      <xs:element name="ServiceArea" type="xs:string" minOccurs="0"/>
      <xs:element name="Description" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ContactPoint">
    <xs:annotation>
      <xs:appinfo><crm:table>contact_points</crm:table><crm:phase status="shipped">v0</crm:phase></xs:appinfo>
      <xs:documentation>A phone, email, address, website or social profile. A phone is E.164; an email is lower case.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Id" type="crm:Uuid"/>
      <xs:element name="TenantId" type="crm:Uuid"/>
      <xs:element name="ParticipantId" type="crm:Uuid"/>
      <xs:element name="Kind" type="crm:ContactPointKind"/>
      <xs:element name="Label" type="crm:ContactPointLabel"/>
