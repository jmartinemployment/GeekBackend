# GeekMcpGateway — Railway / Docker (Node 22). Stateless: it holds no database connection and no tenant data.
# Build context MUST be the GeekBackend repo root.
#
# Railway service geek-mcp-gateway: private network only, no public domain, port 3000.
#   Config-as-code path: railway.geekmcpgateway.toml
#
#   docker build -f Dockerfile.gateway -t geek-mcp-gateway .

FROM node:22-alpine AS build
WORKDIR /app
COPY GeekMcpGateway/package.json GeekMcpGateway/package-lock.json ./
RUN npm ci
COPY GeekMcpGateway/tsconfig.json GeekMcpGateway/tsconfig.build.json ./
COPY GeekMcpGateway/src ./src
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY GeekMcpGateway/package.json GeekMcpGateway/package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
ENV PORT=3000
EXPOSE 3000
USER node
CMD ["node", "dist/src/main.js"]
