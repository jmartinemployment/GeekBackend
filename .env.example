# GeekRepository
DATABASE_URL=postgresql://user:password@localhost:5432/geekbackend
# Interim local/CI only — do not use in production (see Architecture.md)
# REPO_API_KEY=local-dev-only

# GeekAPI internal routes (Geek-GTM-MCP uses /api/gtm/internal/* with this key + X-Geek-User-Id)
PORT=8080
ASPNETCORE_ENVIRONMENT=Development
REPO_URL=http://localhost:5050
GEEK_BACKEND_API_KEY=change-me-api-key
CORS_ORIGINS=http://localhost:3000,https://geekatyourspot.com,https://www.geekatyourspot.com,http://127.0.0.1

# Target S2S (when authorization server is deployed)
# AUTH_SERVER_URL=https://auth.geekatyourspot.com
# GEEKAPI_CLIENT_ID=geekapi
# GEEKAPI_CLIENT_SECRET=

# Content Creator v2 realtime hub (/hubs/gcc-v2-realtime) — GeekOAuth issuer used to validate the
# JWT SignalR clients send as ?access_token=. Falls back to AUTH_SERVER_URL above if unset.
# GEEK_OAUTH_AUTHORITY=https://auth.geekatyourspot.com
# Optional: lets GeekAPI LISTEN for gcc_v2_job NOTIFY across instances. Falls back to DATABASE_URL.
# GCC_V2_LISTEN_DATABASE_URL=postgresql://user:password@localhost:5432/geekbackend

# Optional: Geek-Crawler-Rag (Hostinger) — thin index trigger + WRITE retrieval
# GEEK_CRAWLER_RAG_URL=http://2.24.101.90:8080
# GEEK_CRAWLER_RAG_API_KEY=

# Optional
BCRYPT_WORK_FACTOR=12

# Integration tests
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/geekbackend_test
TEST_REPO_URL=http://127.0.0.1:5050
