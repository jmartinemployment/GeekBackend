<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Underscore-separated xUnit test method names are the convention here; CA1707 would fire on
         every one of them and drown out the real analyzer findings. Suppressed in test code only. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\GeekRepository\Migrations\Sql\*.sql" Link="Migrations\Sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Geek-CRM's contract model, shared with GeekBackend.Tests so both judge the same XSD. -->
    <Compile Include="..\GeekBackend.Tests\Crm\CrmXsdContract.cs" Link="Crm\CrmXsdContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeekAPI\GeekAPI.csproj" Aliases="GeekApi" />
    <ProjectReference Include="..\GeekRepository\GeekRepository.csproj" Aliases="GeekRepo" />
    <ProjectReference Include="..\GeekApplication\GeekApplication.csproj" />
  </ItemGroup>

</Project>
