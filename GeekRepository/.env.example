# GeekRepository Environment Variables
# Copy this file to .env and fill in your values

# Supabase PostgreSQL (schema: content-writer-3)
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres?schema=content-writer-3&sslmode=require

# Local development (PostgreSQL on localhost)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=content-writer-3

# Port to run on (default: 5050)
PORT=5050

# Optional: Separate Geek SEO database (falls back to DATABASE_URL if not set)
# GEEK_SEO_DATABASE_URL=postgresql://username:password@host:port/geek_seo
