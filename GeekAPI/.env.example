# GeekAPI Environment Variables
# Copy this file to .env and fill in your values

# Port to run on (default: 8080)
PORT=5000

# GeekRepository (data layer) connection
REPO_URL=http://localhost:5050
REPO_API_KEY=dev-api-key

# API authentication key for clients
GEEK_BACKEND_API_KEY=dev-api-key

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,https://www.geekatyourspot.com,https://admin.geekatyourspot.com,https://content-writer.geekatyourspot.com,https://content-writer-3.vercel.app,https://geek-content-creator.vercel.app

# Optional: Geek-SEO Niche Analyzer for live Site Analyzer gaps (falls back to demo)
# Production: https://seo-api.geekatyourspot.com
# GEEK_SEO_API_URL=https://seo-api.geekatyourspot.com
GEEK_SEO_API_URL=

# WordPress integration (optional)
WORDPRESS_URL=https://blog.example.com

# Claude API for content generation (optional)
ANTHROPIC_API_KEY=sk-ant-your-key-here
